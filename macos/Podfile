platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end

  # 注入「拷贝嵌入式 PostgreSQL 进 .app」构建阶段（幂等）。
  # 资源在 macos/Runner/Resources/pg/<platform>/，由 scripts/pg/fetch-binaries.sh 置备
  # （macOS upstream 分支即委托 make-relocatable-macos.sh；对象存储为覆盖模式）。
  # 在签名前运行，把 PG 拷进 Contents/Resources/pg/。
  require 'xcodeproj'
  runner_project_path = File.join(__dir__, 'Runner.xcodeproj')
  if File.exist?(runner_project_path)
    runner_project = Xcodeproj::Project.open(runner_project_path)
    phase_name = 'Bundle Embedded PostgreSQL'
    runner_project.targets.each do |t|
      next unless t.name == 'Runner'
      next if t.shell_script_build_phases.any? { |p| p.name == phase_name }
      phase = t.new_shell_script_build_phase(phase_name)
      phase.shell_script = <<~'SCRIPT'
        set -e
        ARCH_DIR="macos-arm64"
        [ "$(uname -m)" = "x86_64" ] && ARCH_DIR="macos-x64"
        SRC="${SRCROOT}/Runner/Resources/pg/${ARCH_DIR}"
        DST="${BUILT_PRODUCTS_DIR}/${PRODUCT_NAME}.app/Contents/Resources/pg/${ARCH_DIR}"
        if [ -d "$SRC/bin" ]; then
          echo "Bundling embedded PostgreSQL: $SRC -> $DST"
          /bin/mkdir -p "$DST"
          /usr/bin/rsync -a --delete "$SRC/" "$DST/"
        else
          echo "warning: embedded PostgreSQL not found at $SRC; run scripts/pg/make-relocatable-macos.sh"
        fi
      SCRIPT
      phase.run_only_for_deployment_postprocessing = '0'
      # 拷贝阶段无声明 outputs，标记为「总是运行」以消除 Xcode 依赖分析警告。
      phase.always_out_of_date = '1'
    end
    runner_project.save
  end
end
