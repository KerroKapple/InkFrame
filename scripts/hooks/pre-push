#!/usr/bin/env bash
# pre-push: 跑全量测试。失败阻断 push。
set -euo pipefail

# worktree / agent 调用场景下，外部可能注入 GIT_DIR 等变量，
# 污染 hook 内部 git/flutter 的仓库探测（flutter 会报 "0.0.0-unknown"）。
unset GIT_DIR GIT_INDEX_FILE GIT_PREFIX GIT_WORK_TREE GIT_COMMON_DIR

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-push] flutter test"
flutter test

echo "[pre-push] OK"
