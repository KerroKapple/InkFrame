{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/check-magic-strings.sh \"$CLAUDE_TOOL_INPUT_PATH\""
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/check-inline-styles.sh \"$CLAUDE_TOOL_INPUT_PATH\""
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/check-direct-instantiation.sh \"$CLAUDE_TOOL_INPUT_PATH\""
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/check-disposable-cleanup.sh \"$CLAUDE_TOOL_INPUT_PATH\""
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/check-i18n-coverage.sh \"$CLAUDE_TOOL_INPUT_PATH\""
          }
        ]
      }
    ]
  }
}
